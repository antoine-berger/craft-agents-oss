{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "gate",
    "round",
    "actor",
    "findings",
    "counters"
  ],
  "properties": {
    "gate": {
      "type": "string",
      "enum": [
        "review"
      ]
    },
    "round": {
      "type": "integer"
    },
    "actor": {
      "type": "string",
      "enum": [
        "codex-comments"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "file",
          "line",
          "claim",
          "evidence",
          "fix",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": "integer"
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "fix": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "false",
              "rule"
            ]
          }
        }
      }
    },
    "counters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "accepted",
          "reason"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "minLength": 1
          },
          "accepted": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
